#include <windows.h>
#include "resource.h"

IDI_APP ICON "efficientlamp.ico"
IDR_LOGO RCDATA "logo.png"
IDR_TILE_DESKCATS RCDATA "tile-deskcats.png"
IDR_TILE_SNOWDESK RCDATA "tile-snowdesk.png"
IDR_TILE_TRIGGERSWITCH RCDATA "tile-triggerswitch.png"
IDR_TILE_WAVEMUTESYNC RCDATA "tile-wavemutesync.png"
CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "app.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040704b0"
    BEGIN
      VALUE "CompanyName", "efficient lamp"
      VALUE "FileDescription", "efficient lamp - Launcher"
      VALUE "FileVersion", "1.0.0.0"
      VALUE "InternalName", "EfficientLamp"
      VALUE "LegalCopyright", "MIT-Lizenz"
      VALUE "OriginalFilename", "EfficientLamp.exe"
      VALUE "ProductName", "efficient lamp"
      VALUE "ProductVersion", "1.0.0.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x407, 1200
  END
END
