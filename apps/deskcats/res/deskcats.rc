#include <windows.h>

1 ICON "deskcats.ico"
2 RCDATA "logo.png"
CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "app.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,1,0
 PRODUCTVERSION 1,0,1,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040704b0"
    BEGIN
      VALUE "CompanyName", "DeskCats"
      VALUE "FileDescription", "DeskCats - Katzen auf dem Desktop"
      VALUE "FileVersion", "1.0.1.0"
      VALUE "InternalName", "DeskCats"
      VALUE "OriginalFilename", "DeskCats.exe"
      VALUE "ProductName", "DeskCats"
      VALUE "ProductVersion", "1.0.1.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x407, 1200
  END
END
