#include <windows.h>
#include "resource.h"

IDI_APP ICON "fragdesk.ico"
CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "app.manifest"

// Radarbilder der 2D-Ansicht
#include "radars.rc"

// Handy-App (web/, erzeugt von tools/make_web.py)
#include "web.rc"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,4,0,0
 PRODUCTVERSION 1,4,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040704b0"
    BEGIN
      VALUE "CompanyName", "FragDesk"
      VALUE "FileDescription", "FragDesk - CS2-Stats und Highlights"
      VALUE "FileVersion", "1.4.0.0"
      VALUE "InternalName", "FragDesk"
      VALUE "OriginalFilename", "FragDesk.exe"
      VALUE "ProductName", "FragDesk"
      VALUE "ProductVersion", "1.4.0.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x407, 1200
  END
END
